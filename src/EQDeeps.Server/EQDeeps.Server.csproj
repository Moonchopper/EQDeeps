<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>EQDeeps.Server</RootNamespace>
    <Description>EQDeeps local backend: sessions REST API + SignalR realtime channel.</Description>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <ApplicationIcon>Assets\eqdeeps.ico</ApplicationIcon>
    <!-- The exe is a windowed app (WebView2 shell hosts the SPA); WinExe keeps
         a console window from flashing when double-clicked. Program attaches
         to the parent console so terminal launches still print. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The built SPA is embedded into the assembly so the published output is
         one self-contained exe; dev builds serve the physical wwwroot instead. -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <!-- Keep package XML doc files (WebView2) out of the shipped folder. -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EQDeeps.Server.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <!-- Update checking/download/Ed25519 verification (ADR-010). The UI packages
         are deliberately not referenced: the SPA is the only update UI. -->
    <PackageReference Include="NetSparkleUpdater.SparkleUpdater" Version="3.1.0" />
    <ProjectReference Include="..\EQDeeps.Core\EQDeeps.Core.csproj" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.8" />
  </ItemGroup>
  <ItemGroup>
    <!-- The demo log ships inside the exe (see SampleLog); pre-gzipped so the
         binary stays small and git stores one compact blob. -->
    <EmbeddedResource Include="Assets\sample-log.txt.gz" />
    <EmbeddedResource Include="wwwroot\**" />
    <!-- Don't also copy wwwroot beside the exe on publish; it ships embedded. -->
    <Content Remove="wwwroot\**" />
    <None Include="wwwroot\**" CopyToOutputDirectory="Never" />
  </ItemGroup>
  <!-- Licence text has to ship with the binary, not just sit in the repo.
       A self-contained publish lays the whole .NET runtime down beside the app
       and copies none of its licence files, and the MIT/Apache/OFL components
       bundled into the exe all require their notice to travel with the copy.
       This lives here rather than in scripts/publish.ps1 because the release
       workflow calls `dotnet publish` directly — a script-side copy would be
       correct on a developer's machine and missing from every actual release. -->
  <Target Name="PublishLicenseNotices" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(MSBuildThisFileDirectory)..\..\LICENSE">
        <RelativePath>LICENSE.txt</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(MSBuildThisFileDirectory)..\..\NOTICE">
        <RelativePath>NOTICE.txt</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(MSBuildThisFileDirectory)..\..\THIRD-PARTY-NOTICES.txt">
        <RelativePath>THIRD-PARTY-NOTICES.txt</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
    <!-- The runtime packs carry their own licence and third-party notices, and
         which of the two exists differs per pack (WindowsDesktop ships LICENSE
         with no notices; AspNetCore ships notices with no LICENSE). Glob what
         is there out of the pack MSBuild already resolved, rather than hard-code
         a NuGet path and a version the SDK band will move underneath us. -->
    <ItemGroup Condition="'$(SelfContained)' == 'true'">
      <_RuntimePackNotice Include="%(ResolvedRuntimePack.PackageDirectory)\LICENSE*;%(ResolvedRuntimePack.PackageDirectory)\THIRD-PARTY-NOTICES*">
        <Pack>%(ResolvedRuntimePack.Identity)</Pack>
      </_RuntimePackNotice>
      <ResolvedFileToPublish Include="@(_RuntimePackNotice)">
        <RelativePath>licenses\%(_RuntimePackNotice.Pack)\%(_RuntimePackNotice.Filename)%(_RuntimePackNotice.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
